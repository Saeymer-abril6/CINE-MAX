<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.cinemax.controller.VentaController"
      styleClass="modulo" spacing="10.0">

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Registrar venta" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Los totales se calculan con IGV del 18 %" styleClass="texto-ayuda"/>
    </HBox>

    <GridPane hgap="10.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints minWidth="70.0" prefWidth="80.0"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="230.0"/>
            <ColumnConstraints minWidth="70.0" prefWidth="90.0"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="230.0"/>
            <ColumnConstraints minWidth="70.0" prefWidth="80.0"/>
            <ColumnConstraints hgrow="ALWAYS" prefWidth="130.0"/>
        </columnConstraints>

        <Label text="Cliente *" styleClass="campo-etiqueta"
               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="cbxCliente" maxWidth="Infinity" promptText="Selecciona un cliente"
                  GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Fecha *" styleClass="campo-etiqueta"
               GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <DatePicker fx:id="dpFecha" maxWidth="Infinity"
                    GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Cantidad *" styleClass="campo-etiqueta"
               GridPane.columnIndex="4" GridPane.rowIndex="0"/>
        <TextField fx:id="txtCantidad" promptText="1" maxWidth="Infinity"
                   GridPane.columnIndex="5" GridPane.rowIndex="0"/>

        <Label text="Producto *" styleClass="campo-etiqueta"
               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cbxProducto" maxWidth="Infinity" promptText="Dulcería o entrada"
                  GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Función" styleClass="campo-etiqueta"
               GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <ComboBox fx:id="cbxFuncion" maxWidth="Infinity" promptText="Solo para entradas"
                  GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <HBox spacing="8.0" GridPane.columnIndex="4" GridPane.rowIndex="1"
              GridPane.columnSpan="2" alignment="CENTER_LEFT">
            <Button text="Agregar" onAction="#onAgregarDetalle" styleClass="boton-primario"/>
            <Button text="Quitar" onAction="#onQuitarDetalle" styleClass="boton-secundario"/>
        </HBox>
    </GridPane>

    <Separator/>

    <TableView fx:id="tblDetalle" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDetProducto" text="Producto" prefWidth="230.0"/>
            <TableColumn fx:id="colDetFuncion" text="Función" prefWidth="290.0"/>
            <TableColumn fx:id="colDetCantidad" text="Cant." prefWidth="70.0"/>
            <TableColumn fx:id="colDetPrecio" text="Precio" prefWidth="95.0"/>
            <TableColumn fx:id="colDetImporte" text="Importe" prefWidth="105.0"/>
            <TableColumn fx:id="colDetUtilidad" text="Utilidad" prefWidth="100.0"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="12.0">
        <VBox spacing="2.0">
            <Label text="Neto" styleClass="campo-etiqueta"/>
            <Label fx:id="lblNeto" text="S/ 0.00" styleClass="total-menor"/>
        </VBox>
        <VBox spacing="2.0">
            <Label text="IGV (18 %)" styleClass="campo-etiqueta"/>
            <Label fx:id="lblIgv" text="S/ 0.00" styleClass="total-menor"/>
        </VBox>
        <VBox spacing="2.0">
            <Label text="Total a pagar" styleClass="campo-etiqueta"/>
            <Label fx:id="lblTotal" text="S/ 0.00" styleClass="total-mayor"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="lblMensaje" wrapText="true" maxWidth="330.0"/>

        <Button text="Limpiar" onAction="#onLimpiar" styleClass="boton-secundario"/>
        <Button text="Registrar venta" onAction="#onRegistrar" styleClass="boton-primario"/>
    </HBox>
</VBox>
