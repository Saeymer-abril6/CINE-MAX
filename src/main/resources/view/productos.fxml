<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.cinemax.controller.ProductoController"
      styleClass="modulo" spacing="10.0">

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Productos de dulcería y entradas" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Buscar:" styleClass="campo-etiqueta"/>
        <TextField fx:id="txtBuscar" promptText="Nombre del producto" prefWidth="190.0"/>
        <ComboBox fx:id="cbxFiltroCategoria" prefWidth="140.0"/>
    </HBox>

    <HBox spacing="12.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="345.0" spacing="8.0">
            <Label fx:id="lblFormTitulo" text="Nuevo producto" styleClass="titulo-form"/>

            <GridPane hgap="8.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="85.0" prefWidth="105.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Nombre *" styleClass="campo-etiqueta" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" promptText="Ej. Canchita grande" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Categoría *" styleClass="campo-etiqueta" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cbxCategoria" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Unidad *" styleClass="campo-etiqueta" GridPane.rowIndex="2"/>
                <ComboBox fx:id="cbxUnidad" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Costo (S/) *" styleClass="campo-etiqueta" GridPane.rowIndex="3"/>
                <TextField fx:id="txtCosto" promptText="Ej. 6.00" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Utilidad (%) *" styleClass="campo-etiqueta" GridPane.rowIndex="4"/>
                <TextField fx:id="txtUtilidad" promptText="Ej. 50" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Stock *" styleClass="campo-etiqueta" GridPane.rowIndex="5"/>
                <TextField fx:id="txtStock" promptText="Unidades disponibles" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Controla stock" styleClass="campo-etiqueta" GridPane.rowIndex="6"/>
                <CheckBox fx:id="chkControlaStock" text="Descuenta unidades al vender"
                          GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Estado *" styleClass="campo-etiqueta" GridPane.rowIndex="7"/>
                <ComboBox fx:id="cbxEstado" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="7"/>
            </GridPane>

            <Label text="Precio de venta = costo × (1 + % utilidad). Las entradas no manejan stock."
                   styleClass="texto-ayuda" wrapText="true"/>
            <Label fx:id="lblMensaje" wrapText="true"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="8.0">
                <Button text="Guardar" onAction="#onGuardar" styleClass="boton-primario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" onAction="#onCancelar" styleClass="boton-secundario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button text="Nuevo" onAction="#onNuevo" styleClass="boton-secundario"/>
                <Button text="Eliminar" onAction="#onEliminar" styleClass="boton-peligro"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" text="0 registros" styleClass="texto-conteo"/>
            </HBox>

            <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Producto" prefWidth="190.0"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="100.0"/>
                    <TableColumn fx:id="colCosto" text="Costo" prefWidth="85.0"/>
                    <TableColumn fx:id="colUtilidad" text="Utilidad" prefWidth="85.0"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="85.0"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="70.0"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
