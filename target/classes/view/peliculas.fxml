<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.cinemax.controller.PeliculaController"
      styleClass="modulo" spacing="10.0">

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Cartelera de películas" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Buscar:" styleClass="campo-etiqueta"/>
        <TextField fx:id="txtBuscar" promptText="Título o género" prefWidth="200.0"/>
        <ComboBox fx:id="cbxFiltroEstado" prefWidth="140.0"/>
    </HBox>

    <HBox spacing="12.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="330.0" spacing="8.0">
            <Label fx:id="lblFormTitulo" text="Nueva película" styleClass="titulo-form"/>

            <GridPane hgap="8.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="80.0" prefWidth="100.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Título *" styleClass="campo-etiqueta" GridPane.rowIndex="0"/>
                <TextField fx:id="txtTitulo" promptText="Ej. Aventura en los Andes" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Género *" styleClass="campo-etiqueta" GridPane.rowIndex="1"/>
                <TextField fx:id="txtGenero" promptText="Ej. Aventura" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Duración *" styleClass="campo-etiqueta" GridPane.rowIndex="2"/>
                <TextField fx:id="txtDuracion" promptText="Minutos (ej. 110)" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Clasificación *" styleClass="campo-etiqueta" GridPane.rowIndex="3"/>
                <ComboBox fx:id="cbxClasificacion" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Estado *" styleClass="campo-etiqueta" GridPane.rowIndex="4"/>
                <ComboBox fx:id="cbxEstado" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            </GridPane>

            <Label fx:id="lblMensaje" wrapText="true"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="8.0">
                <Button text="Guardar" onAction="#onGuardar" styleClass="boton-primario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" onAction="#onCancelar" styleClass="boton-secundario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button text="Nuevo" onAction="#onNuevo" styleClass="boton-secundario"/>
                <Button text="Eliminar" onAction="#onEliminar" styleClass="boton-peligro"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" text="0 registros" styleClass="texto-conteo"/>
            </HBox>

            <TableView fx:id="tblPeliculas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTitulo" text="Título" prefWidth="230.0"/>
                    <TableColumn fx:id="colGenero" text="Género" prefWidth="120.0"/>
                    <TableColumn fx:id="colDuracion" text="Duración" prefWidth="90.0"/>
                    <TableColumn fx:id="colClasificacion" text="Clasificación" prefWidth="100.0"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="110.0"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
