<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.cinemax.controller.SalaController"
      styleClass="modulo" spacing="10.0">

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Salas del cine" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Buscar:" styleClass="campo-etiqueta"/>
        <TextField fx:id="txtBuscar" promptText="Nombre de la sala" prefWidth="200.0"/>
        <ComboBox fx:id="cbxFiltroTipo" prefWidth="120.0"/>
    </HBox>

    <HBox spacing="12.0" VBox.vgrow="ALWAYS">
        <VBox prefWidth="330.0" spacing="8.0">
            <Label fx:id="lblFormTitulo" text="Nueva sala" styleClass="titulo-form"/>

            <GridPane hgap="8.0" vgap="8.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="80.0" prefWidth="100.0"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Nombre *" styleClass="campo-etiqueta" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombre" promptText="Ej. Sala 4" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Tipo *" styleClass="campo-etiqueta" GridPane.rowIndex="1"/>
                <ComboBox fx:id="cbxTipo" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Capacidad *" styleClass="campo-etiqueta" GridPane.rowIndex="2"/>
                <TextField fx:id="txtCapacidad" promptText="Número de butacas" maxWidth="Infinity"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            </GridPane>

            <Label text="Tipo: 2D, 3D o VIP." styleClass="texto-ayuda"/>
            <Label fx:id="lblMensaje" wrapText="true"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="8.0">
                <Button text="Guardar" onAction="#onGuardar" styleClass="boton-primario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Button text="Cancelar" onAction="#onCancelar" styleClass="boton-secundario"
                        maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button text="Nuevo" onAction="#onNuevo" styleClass="boton-secundario"/>
                <Button text="Eliminar" onAction="#onEliminar" styleClass="boton-peligro"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" text="0 registros" styleClass="texto-conteo"/>
            </HBox>

            <TableView fx:id="tblSalas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Sala" prefWidth="220.0"/>
                    <TableColumn fx:id="colTipo" text="Tipo" prefWidth="120.0"/>
                    <TableColumn fx:id="colCapacidad" text="Capacidad" prefWidth="120.0"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>
</VBox>
