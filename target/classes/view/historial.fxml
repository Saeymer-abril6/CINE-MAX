<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.cinemax.controller.HistorialController"
      styleClass="modulo" spacing="10.0">

    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label text="Historial de ventas" styleClass="titulo-modulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Buscar:" styleClass="campo-etiqueta"/>
        <TextField fx:id="txtBuscarVenta" promptText="Cliente o código" prefWidth="200.0"/>
        <Button text="Refrescar" onAction="#onRefrescar" styleClass="boton-secundario"/>
        <Button text="Eliminar venta" onAction="#onEliminarVenta" styleClass="boton-peligro"/>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <Label fx:id="lblConteoVentas" text="0 ventas" styleClass="texto-conteo"/>
        <Label fx:id="lblResumen" text="Total vendido: S/ 0.00" styleClass="texto-resumen"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblMensajeHistorial" wrapText="true"/>
    </HBox>

    <TableView fx:id="tblVentas" prefHeight="240.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colVentaId" text="Código" prefWidth="90.0"/>
            <TableColumn fx:id="colVentaCliente" text="Cliente" prefWidth="280.0"/>
            <TableColumn fx:id="colVentaFecha" text="Fecha" prefWidth="120.0"/>
            <TableColumn fx:id="colVentaTotal" text="Total" prefWidth="130.0"/>
        </columns>
    </TableView>

    <Label text="Detalle de la venta seleccionada" styleClass="titulo-form"/>

    <TableView fx:id="tblHistorialDetalle" prefHeight="180.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colHistProducto" text="Producto" prefWidth="280.0"/>
            <TableColumn fx:id="colHistFuncion" text="Función" prefWidth="330.0"/>
            <TableColumn fx:id="colHistCantidad" text="Cant." prefWidth="80.0"/>
            <TableColumn fx:id="colHistImporte" text="Importe" prefWidth="120.0"/>
        </columns>
    </TableView>

    <Label text="Al eliminar una venta se devuelve el stock de los productos que lo controlan."
           styleClass="texto-ayuda"/>
</VBox>
